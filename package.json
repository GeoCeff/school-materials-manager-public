{
  "name": "school-materials-manager",
  "productName": "School Materials Manager",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Offline search for PDFs, Word, slides, notes, and code in a read-only local archive.",
  "type": "module",
  "main": "dist/src/desktop/entry.js",
  "scripts": {
    "build": "node scripts/build-parser-host.mjs && tsc && vite build",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && electron . --smoke",
    "package": "npm run build && node scripts/package.mjs",
    "collection:configure-google": "node scripts/configure-collection-google.mjs"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
